# ---------------------------------------------------------------------------
# ContentIQ – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/contentiq

# Secret key used to sign JWT tokens – generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_secret_key

# Allowed frontend origin (React dev server)
FRONTEND_URL=http://localhost:3000

# JWT token expiry in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60
